OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6
OPENAI_VISION_MODEL=gpt-5.6
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
PORT=8080
MAX_FETCH_BYTES=2000000
MAX_MEDIA_BYTES=24000000
MAX_VISUAL_BYTES=18000000

# Comma-separated exact origins allowed to call the gateway from web/native clients. Capacitor Android defaults to https://localhost.
CORS_ORIGINS=

# Large-media resumable gateway (persistent Node host + ffmpeg/ffprobe recommended)
LARGE_MEDIA_ROOT=./data/uploads
MAX_LARGE_MEDIA_BYTES=2000000000
UPLOAD_CHUNK_BYTES=6291456
MEDIA_SEGMENT_SECONDS=600
LARGE_MEDIA_TTL_HOURS=24
MAX_LARGE_MEDIA_TASKS=2
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Optional single-user cloud checkpoint sync. Use a long random secret and persistent disk for SYNC_ROOT.
SYNC_TOKEN=
SYNC_ROOT=./data/sync
MAX_SYNC_BYTES=20000000

# Account/device sessions. Registration is closed unless REGISTRATION_TOKEN is set.
AUTH_ROOT=./data/auth
ACCOUNT_SYNC_ROOT=./data/account-sync
REGISTRATION_TOKEN=
ACCOUNT_SESSION_TTL_DAYS=30
ACCOUNT_MAX_SESSIONS=12
LOGIN_MAX_FAILURES=8
LOGIN_WINDOW_MS=300000
# Recommended true for public production gateways. When true, AI/ingestion/upload routes require an account session.
REQUIRE_ACCOUNT_AUTH=false

# Instagram archive. User-initiated post/reel shares only; no bulk crawling.
INSTAGRAM_ROOT=./data/instagram
MAX_INSTAGRAM_ITEMS=20
MAX_INSTAGRAM_ITEM_BYTES=100000000
PY
